            new("Harvester", "Done", "A fuel-powered machine that harvests and replants crops, with upgrades."),
            new("Seed Reprocessor and Soul Extractor", "Done", "Turn spare seeds into essence, and fill Soul Jars from mob drops."),
            new("Essence Furnace", "Done", "One furnace that takes Machine Upgrades."),
            new("Altar enchanting", "Done", "Enchant books and gear at the Infusion Altar, one level per craft."),
